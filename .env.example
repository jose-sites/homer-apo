# Node >=22.13. Copie para .env; nunca use prefixo VITE_ para segredos.
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Opcional: exige token no painel (Bearer HTTP / cookie HttpOnly para WebSocket).
ADMIN_TOKEN=
# Configure apenas ao servir atrás de um proxy de sua confiança.
PUBLIC_ORIGIN=

# IA: escolha "OpenAI-compatible" no painel após configurar.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY pode ser usado como chave comum à IA e voz.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# TTS: configure uma voz original/licenciada oferecida pelo provedor.
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Overrides opcionais, por personagem; não há clonagem de voz.
TTS_VOICE_HOMER=
TTS_VOICE_MARGE=
TTS_VOICE_BART=
TTS_VOICE_LISA=
TTS_VOICE_MAGGIE=

# Ordem: fish -> openai. Use none para desativar o secundário.
TTS_PRIMARY=fish
TTS_SECONDARY=openai
# TTS_PROVIDER é alias legado; TTS_PRIMARY tem prioridade.
TTS_TIMEOUT_MS=10000
TTS_SPEED=1
FISH_API_KEY=
FISH_MODEL=s2.1-pro
FISH_REFERENCE_ID=
# Catálogo público: Homer Simpson PT BR (Caio Rosa); acesso pela API ainda não validado.
FISH_REFERENCE_ID_HOMER=fdfc92bf6c584d1dbefa61fddbb66db8
FISH_REFERENCE_ID_MARGE=
FISH_REFERENCE_ID_BART=
FISH_REFERENCE_ID_LISA=
FISH_REFERENCE_ID_MAGGIE=
FISH_SPEED=1

# TikTok: conector comunitário; nunca conecta automaticamente ao iniciar.
TIKTOK_ENABLED=false
TIKTOK_USERNAME=
# Opcional, conforme exigências do serviço de assinatura Euler Stream.
TIKTOK_SIGN_API_KEY=
TIKTOK_DEMO=true
